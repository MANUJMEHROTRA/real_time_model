# Which backend renders the final photorealistic try-on:
#   hf-idm    - FREE, no key: IDM-VTON on Hugging Face Spaces (best free quality, tops only, ~20-40 s)
#   hf-ootd   - FREE, no key: OOTDiffusion on Hugging Face Spaces (tops/bottoms/dresses, ~15-30 s)
#   mock      - no network; returns the live-overlay snapshot (for testing the flow)
#   fashn     - FASHN API (commercial-use licensed) - recommended for production
#   replicate - any Replicate try-on model (default IDM-VTON is NON-COMMERCIAL, prototyping only)
TRYON_BACKEND=hf-idm

# Optional for hf-* backends: a free token from https://huggingface.co/settings/tokens raises your GPU quota
HF_TOKEN=

FASHN_API_KEY=
# performance | balanced | quality  (speed vs. fidelity)
FASHN_MODE=balanced

REPLICATE_API_TOKEN=
REPLICATE_MODEL=cuuupid/idm-vton

# Save customer snapshots + results to ./outputs (get consent first!)
SAVE_RESULTS=false

# Seconds before giving up on a render (free HF queues can be slow)
TRYON_TIMEOUT=120
